# ============================================================
# Variables d'environnement — Gestion Stock PME
# Copier ce fichier en ".env" et renseigner les vraies valeurs
# Le fichier ".env" est ignoré par Git (voir .gitignore)
# ============================================================

# --- Base de données MySQL ---
DB_URL=jdbc:mysql://localhost:3306/gestion_stock_pme?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Europe/Paris
DB_USERNAME=pmeuser
DB_PASSWORD=changez_ce_mot_de_passe
DB_ROOT_PASSWORD=changez_ce_mot_de_passe_root

# --- Sécurité JWT ---
# Générer une clé aléatoire forte, par exemple avec :
#   openssl rand -hex 32
# NE JAMAIS committer la vraie valeur de production sur Git.
JWT_SECRET=remplacez_par_une_cle_aleatoire_de_64_caracteres_minimum

# --- Profil Spring actif ---
SPRING_PROFILES_ACTIVE=prod
